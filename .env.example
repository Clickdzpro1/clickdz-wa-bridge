# ClickDZ WA Bridge — environment template.
# Copy to a real env file (e.g. /etc/wa-bridge.env on a droplet) and fill in.
# THIS repo is PUBLIC: never commit a filled-in copy. All secrets live only in
# the deploy target's env (DO App Platform SECRET envs or the droplet env file).

# --- REQUIRED (always) ---
# Bearer token the app sends on admin calls (Authorization: Bearer <BRIDGE_TOKEN>).
BRIDGE_TOKEN=
# Optional legacy fallback for /accounts-created instances. New /instances get
# a generated per-instance HMAC secret that is returned once to the app.
BRIDGE_WEBHOOK_SECRET=
# Where the bridge POSTs inbound messages + status events.
APP_WEBHOOK_URL=https://clickdzmax.vercel.app/api/whatsapp/bridge

# --- REQUIRED when AUTH_STORE=redis (production; App Platform has no disk) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- OPTIONAL ---
# redis | disk. Defaults to redis if KV_REST_API_* are set, else disk.
AUTH_STORE=redis
# Redis key namespace for auth state.
AUTH_STATE_PREFIX=wa:bridge:auth
# HTTP port (App Platform injects PORT; server reads it). Default 8080.
PORT=8080
# pino level: info (prod) | debug (local). Never info-log message bodies.
LOG_LEVEL=info
# Per-account outbound pacing in ms (0 = off). Anti-ban throttle.
SEND_THROTTLE_MS=0
# Disk store root when AUTH_STORE=disk (local dev only).
AUTH_DISK_DIR=./auth_state
# Persisted inbound rich media. On a droplet keep this outside the git checkout.
MEDIA_DIR=./media
# Refuse to persist larger media payloads (default 10 MiB).
MAX_MEDIA_BYTES=10485760
# Delete retained media after this many days (default 30).
MEDIA_RETENTION_DAYS=30
# Optional. Enables the app's WA_GATEWAY_ADMIN_KEY self-provisioning flow; using
# WA_GATEWAY_API_KEY=BRIDGE_TOKEN is simpler and does not require this.
ADMIN_API_KEY=
